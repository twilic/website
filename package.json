{
  "name": "@twilic/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "format": "prettier --write \"{docs/**/*.{md,ts,css},*.{json,md}}\"",
    "format:check": "prettier --check \"{docs/**/*.{md,ts,css},*.{json,md}}\"",
    "lint": "markdownlint-cli2 \"docs/**/*.md\" \"!docs/.vitepress/dist/**\" \"!docs/.vitepress/cache/**\""
  },
  "devDependencies": {
    "html-minifier-terser": "7.2.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.8",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.14.0"
  },
  "dependencies": {
    "@tabler/icons-vue": "3.48.0",
    "mermaid": "12.0.0",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
