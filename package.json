{
  "name": "@twilic/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "format": "prettier --write \"{docs/**/*.{md,ts,css},*.{json,md}}\"",
    "format:check": "prettier --check \"{docs/**/*.{md,ts,css},*.{json,md}}\"",
    "lint": "markdownlint-cli2 \"docs/**/*.md\" \"!docs/.vitepress/dist/**\" \"!docs/.vitepress/cache/**\""
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "^1.13.3"
  },
  "dependencies": {
    "@lucide/vue": "^1.26.0",
    "mermaid": "^11.17.1",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
